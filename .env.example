# Stonk Wars: environment template. Copy to .env.local and fill in.
# Anything prefixed NEXT_PUBLIC_ ships in the browser bundle: never put a key there.

# ── Cluster ────────────────────────────────────────────────────────────────────
# "devnet" or "mainnet-beta". Picks the stock list in src/data/stocks.<cluster>.json.
NEXT_PUBLIC_CLUSTER=devnet
# Browser RPC. The public node works and throttles under a crowd. Set this to
# "/api/rpc" to send the browser through this site's own relay, which forwards
# to RPC_URL with the key attached on the server (app/api/rpc/route.ts). A paid
# endpoint can never go here: this line ships in the page.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional override. Defaults to the address in src/idl/duel.json.
# NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Pyth (server only) ─────────────────────────────────────────────────────────
# Prices the stocks registered with the Pyth source (TSLA, QQQ, VOO on the free
# plan). Hermes requires an API key since the Pyth Core upgrade of 2026-08-26.
# Get one at https://pythdata.app/signup.
PYTH_API_KEY=
HERMES_URL=https://pyth.dourolabs.app/hermes

# ── Trading (buy and sell on a stock's page) ───────────────────────────────────
# Swaps route through Jupiter from the server (lib/jupiter.server.ts). With a key
# (https://developers.jup.ag/portal) it uses api.jup.ag; without, the keyless
# lite host. Either name works. Server only.
JUPITER_API_KEY=
# The platform's cut of a swap in basis points, capped at 100 (1%). 0 or unset
# charges nothing. A fee is charged only when SWAP_FEE_OWNER (a public key, the
# treasury) already has the token account for what the user receives on
# mainnet; otherwise the trade goes through with no fee.
NEXT_PUBLIC_SWAP_FEE_BPS=0
SWAP_FEE_OWNER=
# Mainnet reads for those fee accounts on a non-mainnet deployment (on mainnet,
# RPC_URL is used). Optional; the public node is the fallback.
MAINNET_RPC_URL=

# ── Oracle (server only) ───────────────────────────────────────────────────────
# JSON byte array of the key that signs quotes for every other stock. The config
# on chain names its public key (set_oracle); fights created while it is named
# trust it for their signed sides. Written by scripts/setup-devnet.ts.
ORACLE_SECRET_KEY=

# ── Server RPC (settler, faucet, OG images, /api/rpc) ──────────────────────────
# The only place a paid endpoint's key belongs. It must point at the cluster the
# program is deployed to: a mainnet URL here makes every devnet read come back
# empty. Helius: https://devnet.helius-rpc.com/?api-key=...
RPC_URL=https://api.devnet.solana.com

# ── Settler (server only) ──────────────────────────────────────────────────────
# /api/crank runs the permissionless cranks when an external cron GETs it with
# `Authorization: Bearer $CRON_SECRET`, once a minute. CRANK_SECRET_KEY is the
# JSON byte array of a keypair holding a little SOL for fees. It holds no stake
# and can decide nothing; the secret only stops strangers spending its SOL.
CRON_SECRET=
CRANK_SECRET_KEY=

# ── Page nudge (server only) ───────────────────────────────────────────────────
# An open fight page POSTs /api/nudge, and the server cranks the fight the moment
# its price exists. NUDGE_SECRET_KEY is the JSON byte array of its own fee key,
# so its balance caps what visitors can make the server spend; unset, the nudge
# pays from CRANK_SECRET_KEY and shares the cron's balance, with no separate cap.
# Below NUDGE_MIN_BALANCE_SOL it stops and says "settler low"; left empty, that
# is 0.05 on its own key and 0.3 on the shared one, so the cron keeps some room.
# NUDGE_DISABLED=1 switches it off; the cron carries on.
NUDGE_SECRET_KEY=
NUDGE_MIN_BALANCE_SOL=
NUDGE_DISABLED=

# ── X sign-in (server only) ────────────────────────────────────────────────────
# Optional. Without it the leaderboard shows wallet addresses and the connect
# button says so. Make a Web App at developer.x.com with these callback URLs:
#   https://stonkwars.fun/api/x/callback  and  http://localhost:3000/api/x/callback
# Scopes: users.read and tweet.read. Do NOT enable offline.access: we never want
# a refresh token. The secret also keys the short-lived cookie that carries a
# verified handle from X's redirect to the wallet's signature.
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Devnet faucet (server only, devnet only) ───────────────────────────────────
# JSON byte array of the keypair that is mint authority for the test stocks and
# holds devnet SOL to hand out (and to pay for players' token accounts).
# Written by scripts/setup-devnet.ts.
FAUCET_SECRET_KEY=

# ── Sparring wallet (devnet only, optional) ────────────────────────────────────
# A disclosed opponent for a visitor on their own. It takes timed challenges of
# 24 hours or less addressed to it (/api/spar), and keeps eight open seats of its
# own on the board (15 minute rounds while the market is open, 12 hours or more
# when it is shut), topping itself up from the faucet key above in the same
# transaction. NEXT_PUBLIC_SPAR_WALLET is its PUBLIC key, which the site names
# "Sparring wallet"; SPAR_SECRET_KEY is its JSON byte array and must match. The
# once-a-minute crank runs its tick (takes, seat refills, expired seat cancels);
# an external cron can also GET /api/spar with `Authorization: Bearer $CRON_SECRET`.
# Leave both empty and nothing about sparring appears.
NEXT_PUBLIC_SPAR_WALLET=
SPAR_SECRET_KEY=

# ── Optional ───────────────────────────────────────────────────────────────────
# The other half of the product, when there is one: a devnet site links to its
# mainnet sibling and back (lib/deployment.ts). Leave empty and no strip shows.
NEXT_PUBLIC_DEVNET_SITE=
NEXT_PUBLIC_MAINNET_SITE=
# JUP_API_KEY is read as an alias of JUPITER_API_KEY above; set either one.
# Local development only: 1 serves made-up prices from lib/devPrices.ts so a
# local validator's fights can settle without any market data. Never in production.
DEV_FAKE_PRICES=
