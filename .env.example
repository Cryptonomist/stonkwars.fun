# Stonk Wars: environment template. Copy to .env.local and fill in.
# Anything prefixed NEXT_PUBLIC_ ships in the browser bundle: never put a key there.

# ── Cluster ────────────────────────────────────────────────────────────────────
# "devnet" or "mainnet-beta". Picks the stock list in src/data/stocks.<cluster>.json.
NEXT_PUBLIC_CLUSTER=devnet
# Browser RPC. Public devnet is fine for the demo; use a proxy for anything real.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional override. Defaults to the address in src/idl/duel.json.
# NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Pyth (server only) ─────────────────────────────────────────────────────────
# Hermes requires an API key since the Pyth Core upgrade of 2026-08-26.
# Get one at https://pythdata.app/signup (free trial).
PYTH_API_KEY=
HERMES_URL=https://hermes.pyth.network

# ── Server RPC (settler, faucet, OG images) ────────────────────────────────────
RPC_URL=https://api.devnet.solana.com

# ── Devnet faucet (server only, devnet only) ───────────────────────────────────
# JSON byte array of the keypair that is mint authority for the test stocks and
# holds a little devnet SOL to hand out. Written by scripts/setup-devnet.ts.
FAUCET_SECRET_KEY=
